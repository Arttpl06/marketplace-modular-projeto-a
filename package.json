{
  "name": "marketplace",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "smoke": "node scripts/smoke.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "test": "node scripts/test.js",
    "test:unit": "node scripts/test-unit.js",
    "test:coverage": "node scripts/test.js --coverage",
    "lint": "eslint .",
    "perf": "k6 run tests/performance/marketplace.js",
    "seed:verify": "node scripts/seed-verify.js",
    "trace:evidence": "node scripts/trace-evidence.js",
    "lint:openapi": "npx --yes @redocly/cli@1.34.5 lint docs/openapi.json",
    "audit:dependencies": "npm audit --audit-level=high",
    "seed:verify:test": "node scripts/seed-verify.js --test-db",
    "perf:compare": "node scripts/perf-compare.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
