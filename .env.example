NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=marketplace_db
DB_USER=marketplace
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
PAYMENTS_ENABLED=true
CATALOG_CACHE_ENABLED=true
TEST_DB_USER=marketplace_test
TEST_DB_PASSWORD=
SEED_PRODUCTS=1000
SEED_ORDERS=100000

SEED_BATCH_SIZE=500
BENCHMARK_DB_PASSWORD=
# Optional Compose app env file path
APP_ENV_FILE=.env

# k6 CLI options (not automatically loaded by k6)
K6_BIN=k6
BASE_URL=http://localhost:3000
# Optional ID of an existing product
PRODUCT_ID=
